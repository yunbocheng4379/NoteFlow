
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8000
SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data
# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base

# 邮件通知 (SMTP)，用于任务完成后给用户发邮件
# QQ 邮箱: SMTP_HOST=smtp.qq.com, SMTP_PORT=465
# 注意 SMTP_PASSWORD 填「授权码」而不是登录密码 (QQ邮箱设置 → 账户 → POP3/IMAP/SMTP服务 → 生成授权码)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 邮件里"查看笔记"链接使用的前端访问地址
FRONTEND_URL=http://127.0.0.1:3015

# 支付宝 (open.alipay.com)，未配置则该支付方式在下单时报错，不影响其他功能启动
ALIPAY_APP_ID=
# 应用私钥 / 支付宝公钥 PEM 文件路径 (不要提交到 git，放在 backend/secrets/ 下)
ALIPAY_PRIVATE_KEY_PATH=backend/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=backend/secrets/alipay_public_key.pem
ALIPAY_SANDBOX=true
# 支付宝服务器异步通知会 POST 到这个地址，需公网可访问
ALIPAY_NOTIFY_URL=https://your-domain.com/api/billing/notify/alipay

# —— 微信开放平台 · 网站应用 (Web 扫码登录, 独立于小程序 / 微信支付) ——
# 缺失时 /api/auth/wechat/qr-url 返回 500; 或开 WECHAT_WEB_MOCK=true 走本地假登录联调
WECHAT_WEB_APPID=
WECHAT_WEB_SECRET=
# 微信后台配置的"授权回调域"必须与此 base 前缀一致
# 生产: https://your-domain.com   开发: http://localhost:8483
WECHAT_WEB_REDIRECT_BASE=http://localhost:8483
# 扫码完成后, 后端 302 回到前端的地址
WECHAT_WEB_FRONTEND_CALLBACK=http://localhost:3015/wechat/callback
# 开发用: 无资质时开 mock, 固定返回一个 openid, 走完整前后端链路
WECHAT_WEB_MOCK=false

# 微信支付 (pay.weixin.qq.com)，未配置则该支付方式在下单时报错，不影响其他功能启动
# 注意: 微信支付官方沙箱已下线，只能用真实商户号做小额真实交易验证
WECHAT_APP_ID=
WECHAT_MCH_ID=
# API v3 密钥 (商户平台 → 账户中心 → API 安全)
WECHAT_API_V3_KEY=
# 商户 API 证书私钥路径 + 证书序列号 (不要提交到 git，放在 backend/secrets/ 下)
WECHAT_PRIVATE_KEY_PATH=backend/secrets/wechat_apiclient_key.pem
WECHAT_CERT_SERIAL_NO=
# 微信支付服务器异步通知会 POST 到这个地址，需公网可访问
WECHAT_NOTIFY_URL=https://your-domain.com/api/billing/notify/wechat
# =============== 网盘 (Cloud Drive) ===============
# 百度网盘开放平台 (https://pan.baidu.com/union) 申请的应用凭据.
# 未配置则 "网盘 Tab" 里点击登录会报错, 不影响其他功能启动.
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
# 回调地址必须与百度后台配置的完全一致 (包括 scheme + host + port + path).
# 开发时用 localhost 更方便, 建议在百度后台同时加 localhost + 你的内网IP.
BAIDU_PAN_REDIRECT_URI=http://localhost:8483/api/cloud_drive/auth/baidu/callback
