.selector-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  transition: background 0.25s;
}

.overlay-show {
  background: rgba(36, 52, 71, 0.34);
}

.selector-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  transform: translateY(100%);
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.sheet-show {
  transform: translateY(0);
}

/* Header */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  position: relative;
  border-bottom: 1rpx solid #E8EFEC;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #243447;
}

.sheet-close {
  position: absolute;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close text {
  font-size: 32rpx;
  color: #6E8983;
}

/* Tabs */
.sheet-tabs {
  display: flex;
  border-bottom: 1rpx solid #E8EFEC;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.tab-item text {
  font-size: 28rpx;
  color: #6E8983;
}

.tab-active {
  border-bottom: 4rpx solid #167A6E;
}

.tab-active-text {
  color: #167A6E;
  font-weight: 600;
}

/* Body */
.sheet-body {
  flex: 1;
  padding: 24rpx 32rpx 40rpx;
  min-height: 400rpx;
}

/* Provider groups */
.provider-group {
  margin-bottom: 32rpx;
}

.provider-name {
  font-size: 24rpx;
  color: #93A19D;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  display: block;
}

.model-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.model-selected {
  background: #E6F7F5;
  border: 2rpx solid #167A6E;
}

.model-name {
  font-size: 28rpx;
  color: #243447;
}

.model-check {
  color: #167A6E;
  font-size: 28rpx;
  font-weight: 700;
}

/* Styles */
.style-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.style-selected {
  background: #E6F7F5;
  border: 2rpx solid #167A6E;
}

.style-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.style-name {
  font-size: 28rpx;
  color: #243447;
  font-weight: 500;
}

.style-desc {
  font-size: 24rpx;
  color: #6E8983;
}

.style-check {
  color: #167A6E;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 16rpx;
}
