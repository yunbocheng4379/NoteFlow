.chat-bubble {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  align-items: flex-start;
}

.bubble-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-ai {
  background: #E6F7F5;
  margin-right: 16rpx;
}

.avatar-ai text {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
}

.avatar-user {
  background: #E8E8E8;
  margin-left: 16rpx;
}

.avatar-user text {
  color: #6E8983;
  font-size: 22rpx;
  font-weight: 600;
}

.bubble-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.bubble-user .bubble-content {
  align-items: flex-end;
}

.bubble-text {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-ai .bubble-text {
  background: #F5F5F5;
  color: #243447;
  border-top-left-radius: 4rpx;
}

.bubble-user .bubble-text {
  background: #167A6E;
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}

.bubble-time {
  font-size: 20rpx;
  color: #93A19D;
  margin-top: 6rpx;
}

/* Loading animation */
.bubble-loading {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border-top-left-radius: 4rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #93A19D;
  animation: bounce 1.4s infinite both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
.dot:nth-child(3) { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1);
  }
}

/* Error */
.bubble-error {
  padding: 16rpx 24rpx;
  background: #FFF3F3;
  border-radius: 12rpx;
  border-left: 4rpx solid #C66B5D;
}

.bubble-error text {
  font-size: 26rpx;
  color: #C66B5D;
}
