<view class="md-viewer"><block wx:for="{{nodes}}" wx:key="index"><text wx:if="{{item.type === 'h1'}}" class="md-h1"><block wx:for="{{item.content}}" wx:for-item="part" wx:key="index">{{part.content}}</block></text><text wx:elif="{{item.type === 'h2'}}" class="md-h2"><block wx:for="{{item.content}}" wx:for-item="part" wx:key="index">{{part.content}}</block></text><text wx:elif="{{item.type === 'h3'}}" class="md-h3"><block wx:for="{{item.content}}" wx:for-item="part" wx:key="index">{{part.content}}</block></text><text wx:elif="{{item.type === 'h4'}}" class="md-h4"><block wx:for="{{item.content}}" wx:for-item="part" wx:key="index">{{part.content}}</block></text><view wx:elif="{{item.type === 'p'}}" class="md-p"><block wx:for="{{item.content}}" wx:for-item="part" wx:key="index"><text class="md-{{part.type}}">{{part.content}}</text></block></view><view wx:elif="{{item.type === 'hr'}}" class="md-divider"></view><view wx:elif="{{item.type === 'code'}}" class="md-code-block"><text class="code-text">{{item.content}}</text></view><view wx:elif="{{item.type === 'blockquote'}}" class="md-blockquote"><text class="blockquote-text">{{item.content}}</text></view><view wx:elif="{{item.type === 'ul' || item.type === 'ol'}}" class="md-list"><block wx:for="{{item.items}}" wx:for-item="li" wx:key="index"><view class="md-list-item"><text class="{{item.type === 'ul' ? 'list-bullet' : 'list-number'}}">{{item.type === 'ul' ? '•' : (index + 1) + '.'}}</text><text class="list-text"><block wx:for="{{li}}" wx:for-item="part" wx:key="index">{{part.content}}</block></text></view></block></view><view wx:elif="{{item.type === 'image'}}" class="md-image-wrap"><image class="md-image" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bind:tap="onImageTap" lazy-load /><text wx:if="{{item.alt}}" class="md-image-alt">{{item.alt}}</text></view></block></view>
