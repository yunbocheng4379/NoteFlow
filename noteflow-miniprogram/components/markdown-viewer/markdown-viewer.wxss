.md-viewer {
  padding: 24rpx 0;
  line-height: 1.8;
  color: #243447;
}

/* Headings */
.md-h1 {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin: 32rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #E8EFEC;
}

.md-h2 {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin: 28rpx 0 12rpx;
}

.md-h3 {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 8rpx;
}

.md-h4 {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin: 20rpx 0 8rpx;
  color: #6E8983;
}

/* Paragraph */
.md-p {
  margin: 8rpx 0;
}

.md-text {
  font-size: 28rpx;
  line-height: 1.8;
}

/* Inline styles */
.md-bold {
  font-weight: 700;
}

.md-italic {
  font-style: italic;
}

.md-inline-code {
  background: #F0F0F0;
  color: #E83E8C;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  font-family: monospace;
}

.md-link {
  color: #167A6E;
  text-decoration: underline;
}

/* Divider */
.md-divider {
  height: 2rpx;
  background: #E8EFEC;
  margin: 32rpx 0;
}

/* Code Block */
.md-code-block {
  background: #282C34;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  overflow-x: auto;
}

.code-text {
  color: #ABB2BF;
  font-size: 24rpx;
  font-family: 'Courier New', monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

/* Blockquote */
.md-blockquote {
  border-left: 6rpx solid #167A6E;
  padding: 12rpx 24rpx;
  margin: 16rpx 0;
  background: #E6F7F5;
  border-radius: 0 8rpx 8rpx 0;
}

.blockquote-text {
  font-size: 26rpx;
  color: #6E8983;
  font-style: italic;
}

/* Lists */
.md-list {
  margin: 8rpx 0;
  padding-left: 16rpx;
}

.md-list-item {
  display: flex;
  margin: 4rpx 0;
}

.list-bullet {
  font-size: 28rpx;
  color: #6E8983;
  margin-right: 12rpx;
  width: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.list-number {
  font-size: 28rpx;
  color: #6E8983;
  margin-right: 12rpx;
  min-width: 36rpx;
  flex-shrink: 0;
}

.list-text {
  font-size: 28rpx;
  flex: 1;
}

/* Image */
.md-image-wrap {
  margin: 16rpx 0;
}

.md-image {
  width: 100%;
  border-radius: 12rpx;
}

.md-image-alt {
  display: block;
  font-size: 22rpx;
  color: #93A19D;
  text-align: center;
  margin-top: 8rpx;
}
