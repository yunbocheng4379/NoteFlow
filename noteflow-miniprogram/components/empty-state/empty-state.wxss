.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
  margin-bottom: 12rpx;
  text-align: center;
}

.empty-desc {
  font-size: 26rpx;
  color: #6E8983;
  text-align: center;
  line-height: 1.6;
}

.empty-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: #167A6E;
  border-radius: 40rpx;
}

.empty-action-text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}
