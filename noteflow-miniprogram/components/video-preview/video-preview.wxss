.video-preview {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(36, 52, 71, .05);
}

.video-preview::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #167A6E;
  z-index: 1;
}

/* Loading */
.preview-loading {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
}

.loading-thumb {
  width: 200rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.loading-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  justify-content: center;
}

.loading-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: #E8E8E8;
}

.shimmer {
  background: linear-gradient(90deg, #E8E8E8 25%, #F5F5F5 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Error */
.preview-error {
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #C66B5D;
  border: 2rpx solid #C66B5D;
  border-radius: 50%;
  font-size: 30rpx;
}

.error-text {
  font-size: 26rpx;
  color: #6E8983;
  text-align: center;
}

/* Loaded */
.loaded-thumb {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: #F5F5F5;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #167A6E;
  font-size: 34rpx;
  font-weight: 700;
  background: #E6F7F5;
}

.duration-tag {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.7);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.duration-tag text {
  color: #FFFFFF;
  font-size: 22rpx;
}

.platform-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
}

.platform-tag-text {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 500;
}

.loaded-body {
  padding: 20rpx 24rpx;
}

.video-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #243447;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.video-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6E8983;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
