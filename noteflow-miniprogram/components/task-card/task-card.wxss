.task-card { position: relative; display: flex; margin-bottom: 16rpx; overflow: hidden; background: #FFFFFF; border-radius: 18rpx; box-shadow: 0 8rpx 24rpx rgba(36, 52, 71, .05); }
.task-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx; background: #167A6E; }
.card-thumb { position: relative; width: 184rpx; height: 152rpx; flex-shrink: 0; margin-top: 4rpx; background: #E6F7F5; }
.thumb-img { width: 100%; height: 100%; }
.thumb-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #167A6E; font-size: 30rpx; font-weight: 700; }
.platform-badge { position: absolute; top: 12rpx; left: 12rpx; padding: 4rpx 12rpx; background: rgba(36, 52, 71, .72); border-radius: 6rpx; }
.badge-text { color: #FFFFFF; font-size: 18rpx; }
.card-body { display: flex; flex: 1; flex-direction: column; justify-content: space-between; min-width: 0; padding: 24rpx 20rpx 20rpx; }
.card-title { display: -webkit-box; overflow: hidden; color: #243447; font-size: 27rpx; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.status-row, .meta-row { display: flex; align-items: center; gap: 8rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.status-processing { background: #E7B86B; }
.status-success { background: #167A6E; }
.status-error { background: #C66B5D; }
.status-text, .meta-time, .meta-credits { color: #6E8983; font-size: 20rpx; }
.meta-credits { color: #167A6E; }
