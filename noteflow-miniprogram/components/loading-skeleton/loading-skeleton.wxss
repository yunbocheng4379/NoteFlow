.skeleton-wrap {
  padding: 24rpx;
}

.skel-shimmer {
  background: linear-gradient(90deg, #E8E8E8 25%, #F0F0F0 50%, #E8E8E8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

.skel-line {
  height: 24rpx;
  margin-bottom: 16rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Card */
.card-skel {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.card-img {
  width: 200rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* List */
.list-skel {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.list-img {
  width: 200rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}

.list-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

.skel-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.skel-row .skel-line {
  flex: 0 0 auto;
}

/* Detail */
.detail-skel {
  padding: 8rpx 0;
}

.detail-block {
  padding: 16rpx 0;
}
