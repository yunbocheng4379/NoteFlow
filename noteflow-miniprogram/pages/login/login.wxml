<view class="login-page"><view class="login-shell"><view class="login-brand"><view class="brand-mark">N</view><text class="brand-name">NoteFlow</text><text class="brand-copy">把视频，变成可复习的笔记</text></view><button class="wechat-button" loading="{{loading && !fallbackVisible}}" disabled="{{loading}}" bind:tap="onWechatLogin"><text class="wechat-symbol">✓</text><text>微信一键登录</text></button><view class="divider"><text>其他方式</text></view><view wx:if="{{!fallbackVisible}}" class="fallback-entry" bind:tap="onShowFallback"><text>使用邮箱 / 用户名 / 手机号登录</text><text>›</text></view><view wx:else class="account-form"><view class="field"><text class="field-label">账户</text><input value="{{account}}" placeholder="邮箱、用户名或手机号" placeholder-style="color:#9AA9A4" bindinput="onAccountInput" /></view><view class="field"><text class="field-label">密码</text><input value="{{password}}" password placeholder="请输入密码" placeholder-style="color:#9AA9A4" bindinput="onPasswordInput" /></view><text wx:if="{{error}}" class="form-error">{{error}}</text><button class="account-button" loading="{{loading && fallbackVisible}}" disabled="{{loading}}" bind:tap="onAccountLogin">登录</button></view><text wx:if="{{!error}}" class="protocol-copy">登录即表示你同意 NoteFlow 的用户协议与隐私政策</text></view></view>
