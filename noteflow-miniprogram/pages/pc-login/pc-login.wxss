.pc-login-page { min-height: 100vh; padding: 160rpx 48rpx 80rpx; box-sizing: border-box; background: #F7F8F6; }
.pc-login-card { display: flex; align-items: center; flex-direction: column; padding: 56rpx 40rpx 48rpx; background: #FFFFFF; border: 1rpx solid #E8EFEC; border-radius: 32rpx; box-shadow: 0 18rpx 50rpx rgba(36, 52, 71, .06); }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; color: #FFFFFF; background: #167A6E; border-radius: 26rpx; box-shadow: 0 12rpx 24rpx rgba(22, 122, 110, .18); font-size: 42rpx; font-weight: 700; }
.brand-name { margin-top: 18rpx; color: #243447; font-size: 36rpx; font-weight: 700; }
.page-title { margin-top: 56rpx; color: #243447; font-size: 34rpx; font-weight: 600; }
.confirm-panel, .state-panel { display: flex; align-items: center; flex-direction: column; width: 100%; margin-top: 36rpx; }
.confirm-copy { color: #71817C; font-size: 25rpx; line-height: 1.7; text-align: center; }
.confirm-button, .secondary-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; margin-top: 48rpx; padding: 0; color: #FFFFFF; background: #167A6E; border: none; border-radius: 44rpx; font-size: 28rpx; font-weight: 600; }
.cancel-button { width: 100%; margin-top: 18rpx; padding: 16rpx; color: #93A19D; background: transparent; border: none; font-size: 25rpx; }
.state-icon { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; color: #FFFFFF; background: #C66B5D; border-radius: 50%; font-size: 48rpx; font-weight: 700; }
.state-icon.success { background: #167A6E; }
.state-message { margin-top: 28rpx; color: #243447; font-size: 28rpx; font-weight: 600; text-align: center; }
.state-hint { margin-top: 14rpx; color: #93A19D; font-size: 23rpx; }
.secondary-button { margin-top: 42rpx; }
.error-message { width: 100%; margin-top: 22rpx; color: #C66B5D; font-size: 23rpx; line-height: 1.5; text-align: center; }
