<scroll-view class="profile-page" scroll-y enhanced show-scrollbar="{{false}}"><view class="profile-shell"><view class="profile-header"><text class="eyebrow">YOUR SPACE</text><text class="page-title">我的</text></view><view wx:if="{{!isLoggedIn}}" class="login-card card-accent"><view class="avatar-ghost">N</view><view class="user-copy"><text class="user-name">登录 NoteFlow</text><text class="user-desc">同步你的笔记与生成记录</text></view><view class="login-action" bind:tap="onGoLogin">登录 ›</view></view><view wx:else class="user-card card-accent"><view class="user-row"><image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" /><view wx:else class="avatar-ghost">N</view><view class="user-copy"><text class="user-name">{{userInfo.username}}</text><text class="user-desc">{{userInfo.email || userInfo.phone || 'NoteFlow 用户'}}</text></view></view><view class="credit-row"><view><text class="credit-label">可用电力</text><text class="credit-value">{{credits}}</text></view><view class="credit-caption">持续创作<br />保持好奇</view></view></view><view wx:if="{{isLoggedIn}}" class="stats-card"><view class="stat-item"><text class="stat-value">{{totalTasks}}</text><text class="stat-label">生成笔记</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{credits}}</text><text class="stat-label">剩余电力</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{usedProviders.length}}</text><text class="stat-label">使用模型</text></view></view><view wx:if="{{isLoggedIn}}" class="menu-section"><text class="menu-heading">账户与支持</text><block wx:for="{{menuItems}}" wx:key="key"><view class="menu-item" data-item="{{item}}" bind:tap="onMenuTap"><view class="menu-symbol">{{item.symbol}}</view><view class="menu-body"><text class="menu-name">{{item.title}}</text><text class="menu-desc">{{item.desc}}</text></view><text class="menu-arrow">›</text></view></block></view><view wx:if="{{isLoggedIn}}" class="logout-btn" bind:tap="onLogout">退出登录</view><text class="profile-version">NoteFlow · 让理解留下来</text></view></scroll-view>
