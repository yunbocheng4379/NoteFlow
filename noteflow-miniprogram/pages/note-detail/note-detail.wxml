<view class="detail-page">
  <loading-skeleton wx:if="{{loading}}" variant="detail" />
  <view wx:elif="{{loadError}}" class="error-wrap card-accent"><view class="error-symbol">!</view><text class="error-title">笔记暂时打不开</text><text class="error-desc">{{loadError}}</text><view class="retry-btn" bind:tap="loadNote">重新加载</view></view>
  <view wx:else class="detail-content">
    <view class="detail-header card-accent"><text class="detail-kicker">NOTE / {{note.platform || 'VIDEO'}}</text><text class="detail-title">{{note.title}}</text><view class="detail-meta"><text>{{note.model_name || 'NoteFlow AI'}}</text><text wx:if="{{note.credits_used}}">{{note.credits_used}} 电力</text></view></view>
    <view class="tab-bar"><view class="tab {{activeTab === 'note' ? 'tab-active' : ''}}" data-tab="note" bind:tap="onTabChange">笔记</view><view class="tab {{activeTab === 'chat' ? 'tab-active' : ''}}" data-tab="chat" bind:tap="onTabChange">AI 问答</view></view>
    <view wx:if="{{activeTab === 'note'}}" class="note-content"><view wx:if="{{mdNodes.length}}" class="reading-card"><markdown-viewer nodes="{{mdNodes}}" bind:imageTap="onImageTap" /></view><view wx:else class="empty-note"><text>笔记内容为空</text><text>可以返回列表重试生成。</text></view></view>
    <view wx:else class="chat-content"><scroll-view class="chat-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view wx:if="{{chatMessages.length === 0 && !chatLoading}}" class="chat-empty"><view class="chat-orbit">✦</view><text class="chat-empty-title">读到这里，有问题就问</text><text class="chat-empty-text">基于这份笔记，问我任何问题。</text></view><block wx:for="{{chatMessages}}" wx:key="index"><chat-bubble message="{{item}}" loading="{{false}}" error="{{false}}" /></block><chat-bubble wx:if="{{chatLoading}}" message="{{}}" loading="{{true}}" error="{{false}}" /><view wx:if="{{chatError}}" class="chat-error-msg"><text>{{chatError}}</text><text class="retry-chat" bind:tap="onRetryChat">重试</text></view></scroll-view><view class="chat-input-bar"><input class="chat-input" value="{{chatInput}}" placeholder="基于笔记内容提问…" placeholder-style="color:#9AA9A4" bindinput="onChatInput" confirm-type="send" bindconfirm="onSendMessage" disabled="{{chatSending}}" /><view class="chat-send {{chatInput ? 'send-active' : ''}}" bind:tap="onSendMessage">↑</view></view></view>
    <view class="action-bar"><view class="action-item" bind:tap="onShareNote"><text class="action-icon">↗</text><text>分享</text></view><view class="action-item" bind:tap="onCopyContent"><text class="action-icon">□</text><text>复制</text></view><view class="action-item action-danger" bind:tap="onDeleteNote"><text class="action-icon">−</text><text>删除</text></view></view>
  </view>
</view>
