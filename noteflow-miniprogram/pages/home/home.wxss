.home-page { height: 100vh; box-sizing: border-box; background: #F7F8F6; }
.home-shell { padding: 32rpx 32rpx 168rpx; }
.home-header { display: flex; align-items: center; justify-content: space-between; }
.eyebrow { display: block; color: #93A19D; font-size: 18rpx; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.header-logo { display: block; color: #167A6E; font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.credit-pill { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 18rpx; color: #167A6E; background: #E6F7F5; border-radius: 32rpx; font-size: 24rpx; font-weight: 600; }
.credit-pill-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #F49A86; }
.credit-pill-label { color: #6E8983; font-size: 20rpx; font-weight: 400; }
.home-intro { padding: 72rpx 0 56rpx; }
.intro-title { color: #243447; font-size: 56rpx; line-height: 1.22; font-weight: 700; letter-spacing: -2rpx; }
.intro-accent { color: #167A6E; }
.intro-copy { display: block; margin-top: 20rpx; color: #93A19D; font-size: 25rpx; }
.section-label { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 16rpx; color: #52636D; font-size: 26rpx; font-weight: 600; }
.section-note, .section-link { color: #93A19D; font-size: 20rpx; font-weight: 400; }
.input-card, .config-card, .generating-card { position: relative; overflow: hidden; background: #FFFFFF; border-radius: 20rpx; box-shadow: 0 10rpx 30rpx rgba(36, 52, 71, .05); }
.card-accent::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx; background: #167A6E; }
.input-card { padding: 30rpx 28rpx 24rpx; }
.input-heading, .config-heading, .progress-head, .progress-foot { display: flex; align-items: center; justify-content: space-between; }
.input-heading { color: #243447; font-size: 25rpx; font-weight: 600; }
.input-mark { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 12rpx; color: #167A6E; background: #E6F7F5; border-radius: 12rpx; font-size: 28rpx; }
.clear-button { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; color: #93A19D; font-size: 36rpx; font-weight: 300; }
.url-input { width: 100%; height: 76rpx; margin-top: 18rpx; color: #243447; font-size: 30rpx; box-sizing: border-box; }
.input-footer { display: flex; justify-content: space-between; align-items: center; min-height: 32rpx; }
.input-hint, .inline-status { color: #93A19D; font-size: 21rpx; }
.inline-error { flex: 1; color: #C66B5D; font-size: 21rpx; line-height: 1.45; }
.retry-link { margin-left: 16rpx; color: #167A6E; font-size: 22rpx; }
.config-card { margin-top: 20rpx; padding: 28rpx; }
.config-heading { color: #243447; font-size: 25rpx; font-weight: 600; }
.config-edit { color: #167A6E; font-size: 22rpx; font-weight: 400; }
.config-row { display: flex; align-items: center; margin-top: 28rpx; }
.config-item { flex: 1; min-width: 0; }
.config-label { display: block; margin-bottom: 8rpx; color: #93A19D; font-size: 20rpx; }
.config-value { display: block; overflow: hidden; color: #243447; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.config-divider { width: 1rpx; height: 54rpx; margin: 0 24rpx; background: #E8EFEC; }
.config-arrow, .recent-arrow { color: #93A19D; font-size: 36rpx; font-weight: 300; }
.action-section { margin-top: 24rpx; text-align: center; }
.submit-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; padding: 0 36rpx; color: #FFFFFF; background: #167A6E; border: 0; border-radius: 48rpx; box-shadow: 0 12rpx 24rpx rgba(22, 122, 110, .18); font-size: 30rpx; font-weight: 600; }
.submit-btn::after { border: none; }
.submit-disabled { color: #FFFFFF; background: #B8C9C5; box-shadow: none; }
.submit-arrow { margin-left: 16rpx; font-size: 34rpx; font-weight: 300; }
.cost-hint { display: block; margin-top: 14rpx; color: #93A19D; font-size: 21rpx; }
.generating-card { padding: 30rpx 28rpx 26rpx; text-align: left; }
.progress-kicker { color: #243447; font-size: 25rpx; font-weight: 600; }
.progress-number { color: #167A6E; font-size: 25rpx; font-weight: 600; }
.progress-track { height: 10rpx; margin: 24rpx 0 16rpx; overflow: hidden; background: #E6F7F5; border-radius: 8rpx; }
.progress-fill { height: 100%; background: #167A6E; border-radius: 8rpx; transition: width .3s ease; }
.progress-foot { color: #93A19D; font-size: 21rpx; }
.view-task { color: #167A6E; }
.recent-section { margin-top: 56rpx; }
.recent-card { position: relative; display: flex; align-items: center; margin-bottom: 14rpx; padding: 24rpx 22rpx 24rpx 28rpx; overflow: hidden; background: #FFFFFF; border-radius: 16rpx; box-shadow: 0 6rpx 20rpx rgba(36, 52, 71, .04); }
.recent-line { position: absolute; top: 0; bottom: 0; left: 0; width: 4rpx; background: #167A6E; }
.recent-line.failed { background: #C66B5D; }
.recent-line.pending, .recent-line.processing { background: #E7B86B; }
.recent-body { flex: 1; min-width: 0; }
.recent-title { display: block; overflow: hidden; color: #243447; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.recent-meta { display: flex; gap: 10rpx; margin-top: 8rpx; color: #93A19D; font-size: 20rpx; }
.support-card { display: flex; align-items: center; gap: 20rpx; margin-top: 56rpx; padding: 24rpx 26rpx; background: #E6F7F5; border-radius: 18rpx; }
.support-orbit { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: #167A6E; background: #FFFFFF; border-radius: 18rpx; font-size: 30rpx; }
.support-title, .support-copy { display: block; }
.support-title { color: #167A6E; font-size: 25rpx; font-weight: 600; }
.support-copy { margin-top: 5rpx; color: #6E8983; font-size: 21rpx; }
