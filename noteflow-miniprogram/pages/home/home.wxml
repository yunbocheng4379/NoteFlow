<scroll-view class="home-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="home-shell">
    <view class="home-header"><view><text class="eyebrow">NOTEFLOW / MOBILE</text><text class="header-logo">NoteFlow</text></view><view class="credit-pill"><text class="credit-pill-dot"></text><text>{{credits}}</text><text class="credit-pill-label">电力</text></view></view>
    <view class="home-intro"><text class="intro-title">把视频，变成<br /><text class="intro-accent">可复习的笔记</text></text><text class="intro-copy">粘贴链接，留下一份真正属于你的理解。</text></view>

    <view class="section-label"><text>开始记录</text><text class="section-note">支持 B站 · YouTube · 抖音 · 快手</text></view>
    <view class="input-card card-accent"><view class="input-heading"><view class="input-mark">↗</view><text>视频链接</text><view wx:if="{{videoUrl}}" class="clear-button" bind:tap="onClearUrl">×</view></view><input class="url-input" value="{{videoUrl}}" placeholder="粘贴视频链接开始" placeholder-style="color:#9AA9A4" bindinput="onUrlInput" bindconfirm="parseVideoUrl" confirm-type="done" /><view class="input-footer"><text wx:if="{{urlLoading}}" class="inline-status">正在识别视频…</text><text wx:elif="{{urlError}}" class="inline-error">{{urlError}}</text><text wx:else class="input-hint">链接会自动识别平台和视频信息</text><text wx:if="{{urlError && videoUrl}}" class="retry-link" bind:tap="onRetryParse">重试</text></view></view>
    <video-preview wx:if="{{urlParsed || urlLoading}}" videoInfo="{{videoInfo}}" loading="{{urlLoading}}" error="{{urlError}}" />

    <view wx:if="{{urlParsed}}" class="config-card card-accent" bind:tap="onOpenModelSelector"><view class="config-heading"><text>生成设置</text><text class="config-edit">调整</text></view><view class="config-row"><view class="config-item"><text class="config-label">模型</text><text class="config-value">{{selectedModel ? selectedModel.name : '选择模型'}}</text></view><view class="config-divider"></view><view class="config-item"><text class="config-label">风格</text><text class="config-value">{{selectedStyle ? selectedStyle.name : '默认风格'}}</text></view><text class="config-arrow">›</text></view></view>

    <view class="action-section"><view wx:if="{{pendingTaskId}}" class="generating-card card-accent"><view class="progress-head"><text class="progress-kicker">正在整理你的内容</text><text class="progress-number">{{taskProgress}}%</text></view><view class="progress-track"><view class="progress-fill" style="width: {{taskProgress}}%;"></view></view><view class="progress-foot"><text>{{pendingTaskLabel}}</text><text class="view-task" bind:tap="onViewResult">查看任务 ›</text></view></view><button wx:else class="submit-btn {{(!urlParsed || submitting) ? 'submit-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting || (isLoggedIn && !urlParsed)}}" bind:tap="onSubmit"><text>{{isLoggedIn ? '生成我的笔记' : '登录后开始记录'}}</text><text class="submit-arrow">→</text></button><text wx:if="{{urlParsed && selectedModel}}" class="cost-hint">预计消耗 {{selectedModel.credits_per_task || '--'}} 电力</text></view>

    <view wx:if="{{isLoggedIn && recentTasks.length}}" class="recent-section"><view class="section-label"><text>最近生成</text><text class="section-link" bind:tap="onRecentTaskTap">查看全部 ›</text></view><block wx:for="{{recentTasks}}" wx:key="id"><view class="recent-card" data-task="{{item}}" bind:tap="onRecentTaskTap"><view class="recent-line {{item.status}}"></view><view class="recent-body"><text class="recent-title">{{item.title}}</text><view class="recent-meta"><text>{{item.platform || '视频'}}</text><text>·</text><text>{{item.statusLabel}}</text></view></view><text class="recent-arrow">›</text></view></block></view>
    <view wx:else class="support-card"><view class="support-orbit">✦</view><view><text class="support-title">从一个链接开始</text><text class="support-copy">识别、转写、整理，最后留下清晰的重点。</text></view></view>
  </view>
  <model-selector visible="{{modelSelectorVisible}}" providers="{{providers}}" models="{{models}}" styles="{{styles}}" selectedProvider="{{selectedProvider}}" selectedModel="{{selectedModel}}" selectedStyle="{{selectedStyle}}" bind:selectProvider="onSelectProvider" bind:selectModel="onSelectModel" bind:selectStyle="onSelectStyle" bind:close="onCloseModelSelector" />
</scroll-view>
