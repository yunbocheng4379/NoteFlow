page { box-sizing: border-box; color: #243447; background: #F7F8F6; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
.card { background: #FFFFFF; border-radius: 20rpx; }
.text-primary { color: #167A6E; }
.text-muted { color: #93A19D; }
.text-danger { color: #C66B5D; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.empty-wrap { display: flex; align-items: center; justify-content: center; min-height: 60vh; }
button::after { border: none; }
