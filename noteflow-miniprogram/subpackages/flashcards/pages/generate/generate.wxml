<!--生成闪记卡页-->
<view class="container">
  <!-- 笔记选择 + 参数配置 -->
  <view class="config-panel">
    <view class="config-row" bindtap="onSelectNote">
      <text class="config-label">选择笔记</text>
      <view class="config-value-row">
        <text class="config-value {{noteTitle ? '' : 'placeholder'}}">{{noteTitle || '点击选择'}}</text>
        <text class="config-arrow">›</text>
      </view>
    </view>

    <view class="config-row">
      <text class="config-label">卡片数量</text>
      <view class="count-options">
        <text
          wx:for="{{countOptions}}"
          wx:key="*this"
          wx:for-item="n"
          class="count-chip {{count === n ? 'active' : ''}}"
          data-n="{{n}}"
          bindtap="onSelectCount"
        >{{n}} 张</text>
      </view>
    </view>

    <button
      class="generate-btn {{generating ? 'loading' : ''}}"
      bindtap="onGenerate"
      disabled="{{generating}}"
      loading="{{generating}}"
    >
      {{generating ? 'AI 生成中...' : '生成闪记卡'}}
    </button>
  </view>

  <!-- 卡片预览 -->
  <view class="cards-section" wx:if="{{cards.length > 0}}">
    <view class="cards-header">
      <text class="cards-title">预览 ({{cards.length}} 张)</text>
      <view class="cards-actions">
        <text class="action-text" wx:if="{{!saved}}" bindtap="onSave">保存</text>
        <text class="saved-text" wx:else>已保存 ✓</text>
        <text class="action-text" bindtap="onStartStudy">去学习 →</text>
      </view>
    </view>

    <view class="cards-grid">
      <view
        class="flashcard {{item.flipped ? 'flipped' : ''}}"
        wx:for="{{cards}}"
        wx:key="index"
        data-index="{{item.index - 1}}"
        bindtap="onFlipCard"
      >
        <view class="card-inner">
          <view class="card-front">
            <text class="card-label">Q</text>
            <text class="card-content">{{item.front || item.question}}</text>
          </view>
          <view class="card-back">
            <text class="card-label">A</text>
            <text class="card-content">{{item.back || item.answer}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
