/* 生成闪记卡页样式 */
.container {
  background: #F1EFE8;
  min-height: 100vh;
  padding: 24rpx;
}

/* 配置面板 */
.config-panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.config-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.config-row:last-of-type {
  border-bottom: none;
}
.config-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}
.config-value-row {
  display: flex;
  align-items: center;
}
.config-value {
  font-size: 28rpx;
  color: #378ADD;
}
.config-value.placeholder {
  color: #BBB;
}
.config-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 8rpx;
}
.count-options {
  display: flex;
  gap: 12rpx;
}
.count-chip {
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}
.count-chip.active {
  background: #378ADD;
  color: #fff;
}
.generate-btn {
  margin-top: 28rpx;
  background: #378ADD;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 24rpx 0;
  border: none;
}
.generate-btn.loading {
  opacity: 0.7;
}

/* 卡片预览区 */
.cards-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.cards-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.cards-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.cards-actions {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.action-text {
  font-size: 26rpx;
  color: #378ADD;
}
.saved-text {
  font-size: 26rpx;
  color: #07C160;
}

/* 闪记卡 */
.cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.flashcard {
  width: calc(50% - 8rpx);
  height: 240rpx;
  perspective: 1000rpx;
}
.card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transition: transform 0.4s;
  transform-style: preserve-3d;
}
.flipped .card-inner {
  transform: rotateY(180deg);
}
.card-front,
.card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.card-front {
  background: linear-gradient(135deg, #E8F4FD, #D0E8FA);
}
.card-back {
  background: linear-gradient(135deg, #FFF8E1, #FFE082);
  transform: rotateY(180deg);
}
.card-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #999;
  margin-bottom: 12rpx;
}
.card-content {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}
