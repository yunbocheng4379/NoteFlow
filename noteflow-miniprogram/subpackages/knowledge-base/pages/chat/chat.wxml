<!--知识库问答页-->
<view class="container">
  <!-- 空状态提示 -->
  <view class="welcome" wx:if="{{messages.length === 0}}">
    <view class="welcome-icon">🧠</view>
    <text class="welcome-title">知识库问答</text>
    <text class="welcome-desc">基于你的所有笔记内容回答问题。试试问："我这周学到了什么？"</text>

    <view class="suggestions">
      <text class="suggestion-label">试试这些问题：</text>
      <view class="suggestion-chips">
        <text class="chip" data-q="总结最近几篇笔记的核心观点" bindtap="onSuggestion">总结最近几篇笔记的核心观点</text>
        <text class="chip" data-q="哪些视频提到了 AI 相关内容？" bindtap="onSuggestion">哪些视频提到了 AI 相关内容？</text>
        <text class="chip" data-q="帮我梳理所有笔记中的知识点" bindtap="onSuggestion">帮我梳理所有笔记中的知识点</text>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    wx:else
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
    >
      <chat-bubble
        message="{{item}}"
        data-index="{{index}}"
        bind:retry="onRetry"
      />
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <view class="input-wrapper">
      <input
        class="chat-input"
        value="{{inputValue}}"
        placeholder="输入问题..."
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
        adjust-position="{{true}}"
      />
      <button
        class="send-btn {{sending ? 'disabled' : ''}}"
        bindtap="onSend"
        disabled="{{sending || !inputValue.trim()}}"
      >
        {{sending ? '...' : '发送'}}
      </button>
    </view>
  </view>
</view>
