/* 知识库问答页样式 */
.container {
  background: #F1EFE8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 欢迎区 */
.welcome {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}
.welcome-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.suggestions {
  width: 100%;
  max-width: 600rpx;
}
.suggestion-label {
  font-size: 24rpx;
  color: #BBB;
  display: block;
  margin-bottom: 16rpx;
}
.suggestion-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  background: #fff;
  border: 1rpx solid #E0E0E0;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #378ADD;
}
.chip:active {
  background: #F0F7FF;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 16rpx 24rpx;
  overflow-y: auto;
}

/* 底部输入栏 */
.input-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEE;
}
.input-wrapper {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 16rpx;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  padding: 0 8rpx;
}
.send-btn {
  font-size: 26rpx;
  color: #fff;
  background: #378ADD;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}
.send-btn.disabled {
  background: #95BBDD;
}
