/* 合集详情页样式 */
.container {
  background: #F1EFE8;
  min-height: 100vh;
}

/* 头部 */
.header {
  background: #fff;
  padding: 32rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
}
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}
.title-input {
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid #378ADD;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  flex: 1;
}
.edit-btn {
  font-size: 26rpx;
  color: #378ADD;
  padding: 8rpx 16rpx;
}
.cancel-btn {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
}
.meta {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
}
.meta-sep {
  margin: 0 8rpx;
}

/* 笔记列表 */
.note-list {
  padding: 0 24rpx;
}
.note-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}
.note-cover {
  width: 100rpx;
  height: 72rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.note-cover image {
  width: 100%;
  height: 100%;
}
.note-info {
  flex: 1;
  overflow: hidden;
}
.note-title {
  font-size: 28rpx;
  color: #1A1A1A;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.note-time {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 4rpx;
  display: block;
}
.note-action {
  padding: 12rpx;
}
.remove-icon {
  font-size: 36rpx;
  color: #FA5151;
  font-weight: 700;
  line-height: 1;
}

/* 危险操作区 */
.danger-zone {
  padding: 48rpx 24rpx;
  text-align: center;
}
.delete-btn {
  font-size: 28rpx;
  color: #FA5151;
  padding: 16rpx 0;
}
