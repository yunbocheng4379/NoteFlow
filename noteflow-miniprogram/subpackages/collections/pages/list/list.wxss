/* 合集列表页样式 */
.container {
  background: #F1EFE8;
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 网格布局 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 合集卡片 */
.collection-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.card-cover {
  height: 200rpx;
  position: relative;
}
.cover-img {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-color: #EEE;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8F4FD, #D0E8FA);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-icon {
  font-size: 48rpx;
}
.card-body {
  padding: 16rpx 20rpx 8rpx;
}
.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.card-time {
  padding: 0 20rpx 16rpx;
  font-size: 22rpx;
  color: #BBB;
}

/* 悬浮新建按钮 */
.fab {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #378ADD;
  box-shadow: 0 8rpx 24rpx rgba(55,138,221,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.fab:active {
  transform: scale(0.95);
}
.fab-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}

.list-footer {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #BBB;
}
