/* 分享落地页样式 */
.container {
  background: #F1EFE8;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 空状态 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx 0;
  text-align: center;
}
.state-text {
  font-size: 28rpx;
  color: #999;
}
.state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.state-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}
.state-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.enter-btn {
  background: #378ADD;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  border: none;
}

/* 头部 */
.note-header {
  background: #fff;
  padding: 32rpx 24rpx 0;
}
.note-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  display: block;
  margin-bottom: 12rpx;
}
.note-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.meta-item {
  font-size: 24rpx;
  color: #999;
}
.meta-sep {
  margin: 0 8rpx;
  color: #DDD;
}
.note-banner {
  width: calc(100% + 48rpx);
  margin: 0 -24rpx;
  height: 360rpx;
  border-radius: 0;
  overflow: hidden;
}
.note-banner image {
  width: 100%;
  height: 100%;
}

/* 笔记正文 */
.note-body {
  background: #fff;
  padding: 24rpx;
  margin: 16rpx 0;
}

/* 底部引导 */
.footer-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.footer-info {
  display: flex;
  flex-direction: column;
}
.footer-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.footer-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.footer-btn {
  background: linear-gradient(135deg, #378ADD, #2B6CB0);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 36rpx;
  border-radius: 36rpx;
  border: none;
  line-height: 1;
}

/* 悬浮分享 */
.share-fab {
  position: fixed;
  bottom: 200rpx;
  right: 32rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.share-fab:active {
  transform: scale(0.95);
}
.share-fab-icon {
  font-size: 36rpx;
}
